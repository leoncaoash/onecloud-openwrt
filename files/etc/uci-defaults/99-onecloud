#!/bin/sh
# First boot defaults. uci-defaults removes this after it succeeds.

# zram swap: half of RAM, lz4 (the A5 cores are slow, ratio matters less
# than speed). Unsupported algorithms are ignored by the init script.
uci -q set system.@system[0].zram_size_mb='512'
uci -q set system.@system[0].zram_comp_algo='lz4'

# Tokyo. Set here, not by sed on config_generate: OpenWrt 25.12 uses
# timezone='GMT0' / zonename='UTC', so a 'timezone=UTC' substitution misses.
uci -q set system.@system[0].timezone='CST-8'
uci -q set system.@system[0].zonename='Asia/Shanghai'

# Serve time to the LAN as well as sync from upstream.
uci -q set system.ntp.enable_server='1'

uci -q set luci.main.lang='zh_cn'

# Bigger DNS cache: the default 150 entries turns over constantly once a
# few clients and a proxy are asking.
uci -q set dhcp.@dnsmasq[0].cachesize='1000'
uci -q commit dhcp

uci -q commit system
uci -q commit luci

/etc/init.d/irqbalance enable 2>/dev/null

# Use the Ethernet port as a DHCP client.
# Disable LAN DHCP to avoid interfering with the main router.
uci -q set network.lan.proto='dhcp'
uci -q delete network.lan.ipaddr
uci -q delete network.lan.netmask
uci -q delete network.lan.gateway
uci -q delete network.lan.ip6assign
uci -q commit network

uci -q set dhcp.lan.ignore='1'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.ndp='disabled'
uci -q commit dhcp

exit 0
